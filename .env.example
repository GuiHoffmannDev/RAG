# Copy to .env (`make env`). Never commit .env.

# --- Model provider -------------------------------------------------------------------------
# Local inference. Switch to openai and set OPENAI_API_KEY for the hosted profile.
MODEL_PROVIDER=ollama
# OPENAI_API_KEY=
# OLLAMA_URL=http://localhost:11434
# OLLAMA_DOCKER_URL=http://host.docker.internal:11434
# CHAT_MODEL=qwen3.5:4b
# ADDITIONAL_CHAT_MODELS=
# EMBEDDING_MODEL=qwen3-embedding:0.6b
# JUDGE_MODEL=qwen3.5:4b

# --- Retrieval ------------------------------------------------------------------------------
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=          # Qdrant Cloud or a secured server. Not needed for the Compose Qdrant.
# COLLECTION=runbook_ollama
# TOP_K=4
# CANDIDATE_DEPTH=12
# MAX_REWRITES=2
# CHUNK_SIZE=1200
# CHUNK_OVERLAP=200

# --- Deployment (Docker) --------------------------------------------------------------------
# SERVICE=api              # api | ui | all. Compose sets this per service; use `all` on PaaS.
# AUTO_INDEX=true          # Index CORPUS_DIR on start when the collection is missing or empty.
# CORPUS_DIR=assets/corpus
# BIND_ADDR=127.0.0.1      # Use 0.0.0.0 only behind a firewall or reverse proxy.
# API_PORT=8000
# UI_PORT=8501
# DOMAIN=rag.example.com   # Used by `make proxy` (Caddy, automatic HTTPS).
# API_URL=http://localhost:8000   # UI -> API address outside Compose.

# --- Langfuse (cloud or self-hosted) --------------------------------------------------------
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# LANGFUSE_TRACING_ENVIRONMENT=production
# LANGFUSE_TRACING_ENABLED=false

# Optional USD rates per million tokens for the configured hosted models.
# CHAT_INPUT_USD_PER_MILLION=0.15
# CHAT_OUTPUT_USD_PER_MILLION=0.60
# EMBEDDING_USD_PER_MILLION=0.02
